#!/usr/bin/env bash
set -eu

launcher_path="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
project_root="$(CDPATH= cd -- "$(dirname -- "$launcher_path")/.." && pwd)"
python_bin="${THRILLA_PYTHON:-python}"

if ! command -v "$python_bin" >/dev/null 2>&1; then
    echo "Thrilla needs Python 3.9 or newer." >&2
    echo "Termux: pkg install python git -y" >&2
    exit 1
fi

if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$project_root:$PYTHONPATH"
else
    export PYTHONPATH="$project_root"
fi

exec "$python_bin" -m thrilla "$@"

